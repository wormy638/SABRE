alert http $HOME_NET any -> $EXTERNAL_NET any (
    msg:"SABRE-CNC Suspected Static URI Indicator Match [mock_dropper_script.ps1]";
    flow:established,to_server;
    http.uri; content:"/stage2/config.dat?token=demo_test"; startswith;
    classtype:trojan-activity;
    reference:hashes,sha256:af9ef803a97d05fee3d68d24d339fe0fb06642ef876663de437444e8291615c9;
    sid:9239160; rev:1;
)

alert dns $HOME_NET any -> any any (
    msg:"SABRE-CNC Suspected Static DNS Query [mock_dropper_script.ps1 - dropper-sim.example.org]";
    dns.query; content:"dropper-sim.example.org"; nocase; endswith;
    classtype:trojan-activity;
